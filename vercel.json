{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/process-notifications",  "schedule": "0 8 * * *"  },
    { "path": "/api/cron/check-expired-consents", "schedule": "0 9 * * *"  },
    { "path": "/api/cron/detect-anomalies",       "schedule": "0 10 * * *" },
    { "path": "/api/cron/cleanup",                "schedule": "0 2 * * *"  }
  ]
}
