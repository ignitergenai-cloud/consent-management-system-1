# AWS Configuration (Floci/LocalStack)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB
DYNAMODB_TABLE_NAME=cms-consents

# SNS Topics
SNS_CONSENT_EVENTS_TOPIC=arn:aws:sns:us-east-1:000000000000:cms-consent-events
SNS_NOTIFICATION_COMMANDS_TOPIC=arn:aws:sns:us-east-1:000000000000:cms-notification-commands
SNS_NOTIFICATION_EVENTS_TOPIC=arn:aws:sns:us-east-1:000000000000:cms-notification-events
SNS_INCIDENT_EVENTS_TOPIC=arn:aws:sns:us-east-1:000000000000:cms-incident-events
SNS_INTERNAL_COMMANDS_TOPIC=arn:aws:sns:us-east-1:000000000000:cms-internal-commands
SNS_MIMS_INBOUND_TOPIC=arn:aws:sns:us-east-1:000000000000:mims-inbound-incidents
SNS_MIMS_COMMANDS_TOPIC=arn:aws:sns:us-east-1:000000000000:cms-incident-commands

# SQS Queues
SQS_CONSENT_PROCESSING_QUEUE=http://localhost:4566/000000000000/cms-consent-processing-queue
SQS_NOTIFICATION_QUEUE=http://localhost:4566/000000000000/cms-notification-queue
SQS_NOTIFICATION_STATUS_QUEUE=http://localhost:4566/000000000000/cms-notification-status-queue
SQS_INCIDENT_DETECTION_QUEUE=http://localhost:4566/000000000000/cms-incident-detection-queue
SQS_INCIDENT_BRIDGE_QUEUE=http://localhost:4566/000000000000/cms-incident-bridge-queue
SQS_INCIDENT_COMMANDS_QUEUE=http://localhost:4566/000000000000/cms-incident-commands-queue
SQS_INTERNAL_COMMANDS_QUEUE=http://localhost:4566/000000000000/cms-internal-commands-queue

# S3
S3_CONSENT_DOCUMENTS_BUCKET=cms-consent-documents

# SES
SES_FROM_EMAIL=no-reply@cms.example.com

# Service URLs
CONSENT_API_URL=http://localhost:8000
NOTIFICATION_SERVICE_URL=http://localhost:8002

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Incident Detection
INCIDENT_FAILURE_RATE_THRESHOLD=0.3
INCIDENT_DETECTION_INTERVAL_SECONDS=60
INCIDENT_DETECTION_WINDOW_MINUTES=15
