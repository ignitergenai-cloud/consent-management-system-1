FROM python:3.12-slim

WORKDIR /app

# Install shared library first
COPY services/shared /app/services/shared
RUN pip install --no-cache-dir /app/services/shared

# Install service
COPY services/incident-bridge /app/services/incident-bridge
RUN pip install --no-cache-dir /app/services/incident-bridge

EXPOSE 8004

CMD ["uvicorn", "incident_bridge.main:app", "--host", "0.0.0.0", "--port", "8004"]
