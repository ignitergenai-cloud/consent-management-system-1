# Chaos mode — set to true to simulate a critical outage (triggers PagerDuty + New Relic logs)
CHAOS_MODE=true

# AWS Configuration (moto server / LocalStack)
AWS_ENDPOINT_URL=http://localhost:4565
AWS_REGION=us-east-1
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test

# DynamoDB
DYNAMODB_TABLE_NAME=cms-consents

# SNS Topics — all consent lifecycle events fan out through one topic
CONSENT_CREATED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cms-consent-events
CONSENT_GRANTED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cms-consent-events
CONSENT_DENIED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cms-consent-events
CONSENT_EXPIRED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cms-consent-events
CONSENT_REVOKED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cms-consent-events
NOTIFICATION_SENT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cms-notification-commands
INCIDENT_DETECTED_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cms-incident-events

# SQS Queues (shared settings)
CONSENT_CREATED_QUEUE_URL=http://localhost:4565/123456789012/cms-consent-processing-queue
NOTIFICATION_QUEUE_URL=http://localhost:4565/123456789012/cms-notification-queue
INCIDENT_QUEUE_URL=http://localhost:4565/123456789012/cms-incident-detection-queue

# SQS Queues (service-specific)
INTERNAL_COMMANDS_QUEUE_URL=http://localhost:4565/123456789012/cms-internal-commands-queue
NOTIFICATION_STATUS_QUEUE_URL=http://localhost:4565/123456789012/cms-notification-status-queue
INCIDENT_DETECTION_QUEUE_URL=http://localhost:4565/123456789012/cms-incident-detection-queue
SQS_INCIDENT_BRIDGE_QUEUE=http://localhost:4565/123456789012/cms-incident-bridge-queue
SQS_INCIDENT_COMMANDS_QUEUE=http://localhost:4565/123456789012/cms-incident-commands-queue

# SNS Topics (service-specific)
SNS_MIMS_INBOUND_TOPIC=arn:aws:sns:us-east-1:123456789012:mims-inbound-incidents
SNS_INTERNAL_COMMANDS_TOPIC=arn:aws:sns:us-east-1:123456789012:cms-internal-commands

# S3
CONSENT_DOCUMENTS_BUCKET=cms-consent-documents

# SES
FROM_EMAIL=no-reply@cms.example.com

# Service URLs
CONSENT_API_URL=http://localhost:8000
NOTIFICATION_SERVICE_URL=http://localhost:8002

# Incident Detection
FAILURE_RATE_THRESHOLD=0.3
DETECTION_INTERVAL_SECONDS=60
DETECTION_WINDOW_MINUTES=15
